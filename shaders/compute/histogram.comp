#version 450 core

layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer Elevations { float elevations[]; };
layout(std430, binding = 1) buffer Bins { uint bins[]; };

uniform uint uVertexCount;

void main() {
    uint vertex = gl_GlobalInvocationID.x;
    if (vertex >= uVertexCount) {
        return;
    }
    float scaled = (elevations[vertex] + 32767.0) / 65534.0 * 32.0;
    uint bin = uint(clamp(scaled, 0.0, 31.0));
    atomicAdd(bins[bin], 1u);
}
