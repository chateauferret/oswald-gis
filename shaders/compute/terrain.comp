#version 450 core

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer Source { float source[]; };
layout(std430, binding = 1) readonly buffer Selection { float selection[]; };
layout(std430, binding = 2) buffer Error { uint code; uint index; };
layout(std430, binding = 3) writeonly buffer Target { float target[]; };
layout(std430, binding = 4) readonly buffer Positions { vec4 positions[]; };
layout(std430, binding = 5) readonly buffer NeighborOffsets { uint offsets[]; };
layout(std430, binding = 6) readonly buffer Neighbors { uint neighbors[]; };
layout(std430, binding = 7) readonly buffer EdgeDistances { float edgeDistances[]; };

uniform uint uVertexCount;
uniform int uOperation;
uniform int uHasSelection;
uniform int uHasSink;
uniform float uMinimumElevation;
uniform float uParameter0;
uniform float uParameter1;
uniform float uParameter2;
uniform float uParameter3;
uniform float uParameter4;
uniform vec3 uFlowDirection;
uniform uint uRandomSeed;

const float MIN_ELEVATION = -32767.0;
const float MAX_ELEVATION = 32767.0;

void reportError(uint errorCode, uint vertex) {
    if (atomicCompSwap(code, 0u, errorCode) == 0u) {
        index = vertex;
    }
}

bool isSink(uint vertex, float elevation) {
    return elevation <= 0.0 ||
        (uHasSelection != 0 && selection[vertex] == 0.0) ||
        (uHasSink == 0 && elevation == uMinimumElevation);
}

uint pcgHash(uint inputValue) {
    uint state = inputValue * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

void main() {
    uint vertex = gl_GlobalInvocationID.x;
    if (vertex >= uVertexCount) {
        return;
    }

    float elevation = source[vertex];
    float weight = selection[vertex];
    if (isnan(elevation) || isinf(elevation)) {
        reportError(1u, vertex);
        return;
    }
    if (elevation < MIN_ELEVATION || elevation > MAX_ELEVATION) {
        reportError(3u, vertex);
        return;
    }
    if (isnan(weight) || isinf(weight) || weight < 0.0 || weight > 1.0) {
        reportError(3u, vertex);
        return;
    }

    bool sink = isSink(vertex, elevation);
    float desired = elevation;
    if (uOperation == 0) {
        if (uParameter1 < 0.5) {
            desired = uParameter0;
        } else if (uParameter1 < 1.5) {
            desired = elevation + uParameter0;
        } else if (uParameter1 < 2.5) {
            desired = elevation - uParameter0;
        } else if (uParameter1 < 3.5) {
            desired = min(elevation, uParameter0);
        } else {
            desired = max(elevation, uParameter0);
        }
    } else if (uOperation == 1 && !sink) {
        float laplacian = 0.0;
        for (uint edge = offsets[vertex]; edge < offsets[vertex + 1]; ++edge) {
            float distance = edgeDistances[edge];
            uint neighbor = neighbors[edge];
            float neighborElevation = source[neighbor];
            if (!(distance > 0.0) || isnan(distance) || isinf(distance)) {
                reportError(2u, vertex);
                return;
            }
            laplacian += (neighborElevation - elevation) / distance;
        }
        desired = elevation + uParameter0 * laplacian;
    } else if (uOperation == 2 && !sink) {
        float displacement = 0.0;
        for (uint edge = offsets[vertex]; edge < offsets[vertex + 1]; ++edge) {
            uint neighbor = neighbors[edge];
            float neighborElevation = source[neighbor];
            if (isSink(neighbor, neighborElevation)) {
                continue;
            }
            float distance = edgeDistances[edge];
            if (!(distance > 0.0) || isnan(distance) || isinf(distance)) {
                reportError(2u, vertex);
                return;
            }
            float excess = abs(elevation - neighborElevation) - distance * uParameter0;
            if (excess > 0.0) {
                displacement += elevation > neighborElevation ? -0.5 * excess : 0.5 * excess;
            }
        }
        desired = elevation + displacement;
    } else if (uOperation == 3 && !sink) {
        vec3 position = normalize(positions[vertex].xyz);
        vec3 localFlow = uFlowDirection - dot(uFlowDirection, position) * position;
        float flowLength = length(localFlow);
        float parallelDistanceSum = 0.0;
        uint neighborCount = 0u;
        if (flowLength > 0.0) {
            localFlow /= flowLength;
        }
        for (uint edge = offsets[vertex]; edge < offsets[vertex + 1]; ++edge) {
            uint neighbor = neighbors[edge];
            vec3 neighborPosition = normalize(positions[neighbor].xyz);
            float cosine = clamp(dot(position, neighborPosition), -1.0, 1.0);
            vec3 tangent = neighborPosition - cosine * position;
            float tangentLength = length(tangent);
            float distance = edgeDistances[edge];
            if (!(distance > 0.0) || !(tangentLength > 0.0) ||
                isnan(distance) || isinf(distance)) {
                reportError(2u, vertex);
                return;
            }
            if (flowLength > 0.0) {
                parallelDistanceSum += abs(dot(tangent / tangentLength * distance, localFlow));
            }
            ++neighborCount;
        }
        if (neighborCount > 0u) {
            float meanParallelDistance = parallelDistanceSum / float(neighborCount);
            float depth = uParameter1 * uParameter0 *
                (1.0 + uParameter2 * meanParallelDistance);
            desired = elevation - depth;
        }
    } else if (uOperation == 4 && !sink) {
        vec3 position = normalize(positions[vertex].xyz);
        vec3 localFlow = uFlowDirection - dot(uFlowDirection, position) * position;
        float flowLength = length(localFlow);
        float laplacian = 0.0;
        vec3 gradient = vec3(0.0);
        uint neighborCount = 0u;
        for (uint edge = offsets[vertex]; edge < offsets[vertex + 1]; ++edge) {
            uint neighbor = neighbors[edge];
            vec3 neighborPosition = normalize(positions[neighbor].xyz);
            float cosine = clamp(dot(position, neighborPosition), -1.0, 1.0);
            vec3 tangent = neighborPosition - cosine * position;
            float tangentLength = length(tangent);
            float distance = edgeDistances[edge];
            if (!(distance > 0.0) || !(tangentLength > 0.0) ||
                isnan(distance) || isinf(distance)) {
                reportError(2u, vertex);
                return;
            }
            float difference = source[neighbor] - elevation;
            laplacian += difference;
            gradient += (difference / distance) * (tangent / tangentLength);
            ++neighborCount;
        }
        float change = 0.0;
        if (neighborCount > 0u && flowLength > 0.0) {
            localFlow /= flowLength;
            float alpha = dot(gradient / float(neighborCount), localFlow);
            if (alpha > 0.0) {
                change += uParameter1 * laplacian;
            } else if (alpha < 0.0) {
                change -= uParameter2 * uParameter0 * abs(alpha);
            }
        }
        float adjusted = elevation + change;
        float heightAboveCraton = max(0.0, adjusted - uParameter3);
        desired = uParameter3 + (adjusted - uParameter3) /
            (1.0 + uParameter4 * heightAboveCraton);
    } else if (uOperation == 5) {
        float randomValue = float(pcgHash(uint(vertex) ^ uRandomSeed)) *
            (1.0 / 4294967296.0);
        desired = elevation + (2.0 * randomValue - 1.0) * uParameter0;
    }

    if (isnan(desired) || isinf(desired)) {
        reportError(2u, vertex);
        return;
    }
    desired = clamp(desired, MIN_ELEVATION, MAX_ELEVATION);
    float result = elevation + (desired - elevation) * weight;
    if (isnan(result) || isinf(result)) {
        reportError(2u, vertex);
        return;
    }
    target[vertex] = result;
}
